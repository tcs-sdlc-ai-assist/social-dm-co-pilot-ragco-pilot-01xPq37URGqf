# Social DM Copilot - Environment Variables
# Copy this file to .env.local and fill in your values

# Application name displayed in the UI
NEXT_PUBLIC_APP_NAME=Social DM Copilot

# Minimum confidence score (0-1) for AI-generated reply suggestions
NEXT_PUBLIC_CONFIDENCE_THRESHOLD=0.7

# SLA response time target in minutes
NEXT_PUBLIC_SLA_MINUTES=30

# Seed used for client-side encryption of sensitive data
NEXT_PUBLIC_ENCRYPTION_KEY_SEED=your-encryption-key-seed-here